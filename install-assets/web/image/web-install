#!/bin/bash
# Installs a CMS in the site. The panel writes .web/install.json (what to install, the database, the first account) and
# reads .web/install.status to follow it. The file holds passwords: it is removed as soon as it is read.
set -uo pipefail

HOME_DIR=/home/container
WEB="$HOME_DIR/.web"
JOB="$WEB/install.json"
WORK="$WEB/run/install.job"
STATUS="$WEB/install.status"

[[ -f "$JOB" ]] || exit 0
mv "$JOB" "$WORK" || exit 1
chmod 600 "$WORK"
trap 'rm -f "$WORK"; rm -rf "$WEB/tmp/install"' EXIT

PHP_V="$(php -r 'echo PHP_MAJOR_VERSION . "." . PHP_MINOR_VERSION;')"
export PHP_INI_SCAN_DIR="/etc/php/$PHP_V/cli/conf.d:$WEB/conf.d"

get() {
    php -r '$v = json_decode(file_get_contents($argv[1]), true);
        foreach (explode(".", $argv[2]) as $k) { $v = is_array($v) ? ($v[$k] ?? "") : ""; }
        echo is_scalar($v) ? $v : "";' "$WORK" "$1"
}

status() {
    php -r 'file_put_contents($argv[1] . ".new", json_encode(["state" => $argv[2], "app" => $argv[3], "step" => $argv[4],
        "url" => $argv[5], "admin_url" => $argv[6], "at" => time()]));
        rename($argv[1] . ".new", $argv[1]);' "$STATUS" "$1" "$APP" "$2" "${3:-}" "${4:-}"
    chmod 644 "$STATUS"
}

say() {
    echo "[install] $1"
    status running "$1"
}

fail() {
    echo "[install] Failed: $1"
    status failed "$1"
    exit 1
}

APP="$(get app)"
URL="$(get url)"
DOMAIN="$(get domain)"
TITLE="$(get title)"
ADMIN_USER="$(get admin_user)"
ADMIN_PASS="$(get admin_password)"
ADMIN_EMAIL="$(get admin_email)"
LOCALE="$(get locale)"
LOCALE="${LOCALE:-en_US}"
LANG2="${LOCALE%%_*}"
DB_HOST="$(get db.host)"
DB_PORT="$(get db.port)"
DB_NAME="$(get db.name)"
DB_USER="$(get db.user)"
DB_PASS="$(get db.password)"

DOCROOT="${DOCUMENT_ROOT:-public_html}"
DOCROOT="$(echo "$DOCROOT" | sed -e 's#\.\.##g' -e 's#^/*##' -e 's#/*$##' -e 's#[^A-Za-z0-9._/-]##g')"
ROOT="$HOME_DIR/${DOCROOT:-public_html}"
TMP="$WEB/tmp/install"
PHP="php -d memory_limit=512M -d max_execution_time=0"

# A folder that would hold the whole site, or nothing to install: stop before emptying anything.
[[ "$ROOT" != "$HOME_DIR" ]] || fail "The folder of the site cannot be the home folder."
case "$APP" in
    wordpress | joomla | prestashop | nextcloud | dolibarr | drupal) ;;
    *) fail "Unknown application." ;;
esac

mkdir -p "$ROOT"
rm -rf "$TMP"
mkdir -p "$TMP"

fetch() {
    curl -fsSL --retry 3 --connect-timeout 15 "$1" -o "$2" || fail "Could not download $1"
}

# The address of the file of the last release of a GitHub project.
latest_asset() {
    curl -fsSL --retry 3 "https://api.github.com/repos/$1/releases/latest" -o "$TMP/release.json" \
        || fail "Could not read the last version of $1"
    php -r '$r = json_decode(file_get_contents($argv[1]), true);
        foreach ($r["assets"] ?? [] as $a) { if (preg_match($argv[2], $a["name"])) { echo $a["browser_download_url"]; break; } }' \
        "$TMP/release.json" "$2"
}

empty_root() {
    say "Emptying the folder of the site"
    find "$ROOT" -mindepth 1 -delete || fail "Could not empty the folder of the site."
}

preset() {
    echo "$1" >"$WEB/preset"
    chmod 644 "$WEB/preset"
}

install_wordpress() {
    local wp="$PHP /usr/local/bin/wp --path=$ROOT --quiet"
    say "Downloading WordPress"
    $wp core download --locale="$LOCALE" || $wp core download || fail "Could not download WordPress."
    say "Configuring WordPress"
    $wp config create --dbname="$DB_NAME" --dbuser="$DB_USER" --dbpass="$DB_PASS" --dbhost="$DB_HOST:$DB_PORT" \
        --dbcharset=utf8mb4 --skip-check || fail "Could not write the configuration of WordPress."
    say "Creating the site"
    $wp core install --url="$URL" --title="$TITLE" --admin_user="$ADMIN_USER" --admin_password="$ADMIN_PASS" \
        --admin_email="$ADMIN_EMAIL" --skip-email || fail "WordPress could not reach its database."
    $wp rewrite structure '/%postname%/' >/dev/null 2>&1
    preset default
    ADMIN_URL="$URL/wp-admin/"
}

install_joomla() {
    say "Downloading Joomla"
    local file
    file="$(latest_asset joomla/joomla-cms '/Full_Package\.tar\.gz$/')"
    [[ -n "$file" ]] || fail "The last version of Joomla was not found."
    fetch "$file" "$TMP/joomla.tar.gz"
    tar -xzf "$TMP/joomla.tar.gz" -C "$ROOT" || fail "Could not unpack Joomla."
    say "Creating the site"
    (cd "$ROOT" && $PHP installation/joomla.php install --no-interaction --site-name="$TITLE" --admin-user="$ADMIN_USER" \
        --admin-username="$ADMIN_USER" --admin-password="$ADMIN_PASS" --admin-email="$ADMIN_EMAIL" --db-type=mysqli \
        --db-host="$DB_HOST:$DB_PORT" --db-user="$DB_USER" --db-pass="$DB_PASS" --db-name="$DB_NAME" --db-prefix=jos_ \
        --db-encryption=0) >"$WEB/logs/install.log" 2>&1 || fail "Joomla could not be installed: see .web/logs/install.log"
    rm -rf "$ROOT/installation"
    preset default
    ADMIN_URL="$URL/administrator/"
}

install_prestashop() {
    say "Downloading PrestaShop"
    local file
    file="$(latest_asset PrestaShop/PrestaShop '/^prestashop_.*\.zip$/')"
    [[ -n "$file" ]] || fail "The last version of PrestaShop was not found."
    fetch "$file" "$TMP/prestashop.zip"
    unzip -q -o "$TMP/prestashop.zip" -d "$TMP/ps" || fail "Could not unpack PrestaShop."
    unzip -q -o "$TMP/ps/prestashop.zip" -d "$ROOT" || fail "Could not unpack PrestaShop."
    say "Creating the shop (this takes a few minutes)"
    (cd "$ROOT" && $PHP install/index_cli.php --domain="$DOMAIN" --db_server="$DB_HOST:$DB_PORT" --db_name="$DB_NAME" \
        --db_user="$DB_USER" --db_password="$DB_PASS" --prefix=ps_ --email="$ADMIN_EMAIL" --password="$ADMIN_PASS" \
        --firstname=Admin --lastname=Shop --name="$TITLE" --language="$LANG2" --country="$LANG2" \
        --ssl="$([[ "$URL" == https://* ]] && echo 1 || echo 0)") >"$WEB/logs/install.log" 2>&1 \
        || fail "PrestaShop could not be installed: see .web/logs/install.log"
    rm -rf "$ROOT/install"
    # PrestaShop asks for its administration folder to have a name nobody can guess.
    local admin="admin$(head -c 200 /dev/urandom | tr -dc 'a-z0-9' | head -c 8)"
    if [[ -d "$ROOT/admin" ]]; then
        mv "$ROOT/admin" "$ROOT/$admin"
        ADMIN_URL="$URL/$admin/"
    else
        ADMIN_URL="$URL/"
    fi
    preset prestashop
}

install_nextcloud() {
    say "Downloading Nextcloud"
    fetch https://download.nextcloud.com/server/releases/latest.zip "$TMP/nextcloud.zip"
    unzip -q -o "$TMP/nextcloud.zip" -d "$TMP" || fail "Could not unpack Nextcloud."
    (cd "$TMP/nextcloud" && tar -cf - .) | tar -xf - -C "$ROOT" || fail "Could not copy Nextcloud."
    say "Creating the site"
    mkdir -p "$HOME_DIR/nextcloud-data"
    (cd "$ROOT" && $PHP occ maintenance:install --no-interaction --database=mysql --database-host="$DB_HOST:$DB_PORT" \
        --database-name="$DB_NAME" --database-user="$DB_USER" --database-pass="$DB_PASS" --admin-user="$ADMIN_USER" \
        --admin-pass="$ADMIN_PASS" --data-dir="$HOME_DIR/nextcloud-data" \
        && $PHP occ config:system:set trusted_domains 1 --value="$DOMAIN" \
        && $PHP occ config:system:set overwrite.cli.url --value="$URL" \
        && $PHP occ config:system:set overwriteprotocol --value="${URL%%://*}") >"$WEB/logs/install.log" 2>&1 \
        || fail "Nextcloud could not be installed: see .web/logs/install.log"
    preset nextcloud
    ADMIN_URL="$URL/"
}

# The address of the source of the last release of a GitHub project: Dolibarr has no file attached to its releases.
latest_tag() {
    curl -fsSL --retry 3 "https://api.github.com/repos/$1/releases/latest" -o "$TMP/release.json" \
        || fail "Could not read the last version of $1"
    php -r '$r = json_decode(file_get_contents($argv[1]), true); echo preg_replace("/[^0-9A-Za-z.\-]/", "", $r["tag_name"] ?? "");' \
        "$TMP/release.json"
}

install_dolibarr() {
    say "Downloading Dolibarr"
    local tag
    tag="$(latest_tag Dolibarr/dolibarr)"
    [[ -n "$tag" ]] || fail "The last version of Dolibarr was not found."
    fetch "https://github.com/Dolibarr/dolibarr/archive/refs/tags/$tag.tar.gz" "$TMP/dolibarr.tar.gz"
    # Only htdocs is the site: the documents of the client stay out of it.
    tar -xzf "$TMP/dolibarr.tar.gz" --strip-components=2 --wildcards -C "$ROOT" '*/htdocs/*' \
        || fail "Could not unpack Dolibarr."
    say "Creating the site (this takes a few minutes)"
    $PHP /etc/web/dolibarr-setup.php "$WORK" "$ROOT" "$HOME_DIR/dolibarr-documents" "$tag" >"$WEB/logs/install.log" 2>&1 \
        || fail "Dolibarr could not be installed: see .web/logs/install.log"
    preset default
    ADMIN_URL="$URL/"
}

# Drupal has no simple install command: its files are put in place and the last step is its own page.
install_drupal() {
    say "Downloading Drupal"
    fetch https://www.drupal.org/download-latest/tar.gz "$TMP/drupal.tar.gz"
    tar -xzf "$TMP/drupal.tar.gz" --strip-components=1 -C "$ROOT" || fail "Could not unpack Drupal."
    preset drupal
    ADMIN_URL="$URL/core/install.php"
}

ADMIN_URL=""
empty_root
"install_$APP"

# The rules of the application are read by Nginx.
say "Applying the settings of the site"
if [[ -f "$WEB/nginx.conf" ]]; then
    PRESET_FILE="/etc/web/preset-$(cat "$WEB/preset").conf"
    [[ -f "$PRESET_FILE" ]] || PRESET_FILE=/etc/web/preset-default.conf
    sed -i "s#^\(\s*\)include /etc/web/preset-.*#\1include $PRESET_FILE;#" "$WEB/nginx.conf"
    nginx -e stderr -c "$WEB/nginx.conf" -s reload || true
fi

echo "[install] Done: $URL"
status done "Installed" "$URL" "$ADMIN_URL"
