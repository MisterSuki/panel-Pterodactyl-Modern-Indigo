ACME = """    location /.well-known/acme-challenge/ {{
        root {state}/acme;
    }}
"""

HTTP_ONLY = """    listen 80;
    listen [::]:80;
    server_name {names};

{acme}
    location / {{
        return 404;
    }}
"""

SITE = """# Written by pterodactyl-mail-agent: changes here are replaced.
server {{
{http}}}
{https}"""

HTTPS_WEBMAIL = """
server {{
    listen 80;
    listen [::]:80;
    server_name {webmail};

{acme}
    location / {{
        return 301 https://$host$request_uri;
    }}
}}

server {{
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {webmail};

    ssl_certificate {cert}/fullchain.pem;
    ssl_certificate_key {cert}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 30m;

