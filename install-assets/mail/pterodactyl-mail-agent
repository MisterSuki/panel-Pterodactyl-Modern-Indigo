#!/usr/bin/env python3
"""Runs the mail server of the panel on this machine. Written by install.sh (--mail).

The panel keeps the mailboxes; this service asks it for them every few seconds (with the key made in the admin, page
Email) and runs everything here:
 - docker-mailserver (SMTP, IMAP, the Rspamd spam filter, DKIM signing) and Roundcube (the webmail), in Docker;
 - an Nginx site for the webmail, and the Let's Encrypt certificates of the two names;
 - the accounts and quotas files of docker-mailserver, which it reloads by itself when they change;
 - a DKIM key for each new domain, whose record is sent back to the panel for the client to add;
 - how full each mailbox is, whether outgoing port 25 is open, and what went wrong.

It runs as root, so it stays careful:
 - what comes from the panel is checked again here (names, addresses, password hashes), nothing else is written;
 - only its own files are touched: /opt/pterodactyl-mail and the Nginx site ptero-mail.conf;
 - Nginx is tested before every reload, and the previous file is put back if the test fails;
 - the messages of a deleted mailbox are kept 7 days in data/deleted before being removed, and only for mailboxes the
   panel says no longer exist (a suspended site keeps its messages);
 - if the panel does not answer, nothing changes.
"""
import base64
import glob
import hashlib
import json
import os
import re
import secrets
import shutil
import socket
import subprocess
import sys
import time
import urllib.error
import urllib.request

VERSION = '1'
CONFIG = os.environ.get('MAIL_AGENT_CONFIG', '/etc/pterodactyl-mail/agent.json')
BASE = os.environ.get('MAIL_AGENT_BASE', '/opt/pterodactyl-mail')
STATE_DIR = os.environ.get('MAIL_AGENT_STATE_DIR', '/var/lib/pterodactyl-mail')
NGINX_DIR = os.environ.get('MAIL_AGENT_NGINX_DIR', '/etc/nginx')
CERT_DIR = os.environ.get('MAIL_AGENT_CERT_DIR', '/etc/letsencrypt/live')
CONTAINER = 'pterodactyl-mail'
WEBMAIL_CONTAINER = 'pterodactyl-webmail'
WEBMAIL_PORT = 8095
POLL_SECONDS = 15
REPORT_SECONDS = 60
USAGE_SECONDS = 300
PORT25_SECONDS = 3600
KEEP_DELETED_SECONDS = 7 * 86400
RETRY_SECONDS = [300, 900, 3600, 21600]

HOSTNAME = re.compile(r'^(?=.{4,191}$)([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$')
LOCAL = re.compile(r'^[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$')
HASH = re.compile(r'^\{SHA512-CRYPT\}\$6\$[A-Za-z0-9./]{1,16}\$[A-Za-z0-9./]{86}$')
EMAIL = re.compile(r'^[^@\s"\';]+@[^@\s"\';]+\.[^@\s"\';]+$')

